<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shopfloor_menu_form_view" model="ir.ui.view">
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="shopfloor.shopfloor_menu_form_view" />
        <field name="arch" type="xml">
            <group name="multiple_move_single_pack" position="after">
                <group
                    name="use_existing_inventory"
                    invisible="not use_existing_inventory_is_possible"
                >
                    <field name="use_existing_inventory_is_possible" invisible="1" />
                    <field name="use_existing_inventory" />
                </group>
                <group
                    name="inventory_zero_counted_quantity"
                    invisible="not inventory_zero_counted_quantity_is_possible"
                >
                    <field
                        name="inventory_zero_counted_quantity_is_possible"
                        invisible="1"
                    />
                    <field name="inventory_zero_counted_quantity" />
                </group>
                <group
                    name="force_inventory_add_product"
                    invisible="not force_inventory_add_product_is_possible"
                >
                    <field
                        name="force_inventory_add_product_is_possible"
                        invisible="1"
                    />
                    <field name="force_inventory_add_product" />
                </group>
                <group
                    name="display_location_content"
                    invisible="not display_location_content_is_possible"
                >
                    <field name="display_location_content_is_possible" invisible="1" />
                    <field name="display_location_content" />
                </group>
                <group
                    name="ignore_location_ongoing_operation"
                    invisible="not ignore_location_ongoing_operation_is_possible"
                >
                    <field
                        name="ignore_location_ongoing_operation_is_possible"
                        invisible="1"
                    />
                    <field name="ignore_location_ongoing_operation" />
                </group>
                <group
                    name="filtered_warehouse_ids"
                    invisible="not filtered_warehouse_ids_is_possible"
                >
                    <field name="filtered_warehouse_ids_is_possible" invisible="1" />
                    <field
                        name="filtered_warehouse_ids"
                        widget="many2many_tags"
                        options="{'no_create': 1}"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
